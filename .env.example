# Public origin (Render also sets RENDER_EXTERNAL_URL). Change if you use a custom domain.
# SITE_URL=https://notelm.onrender.com
# NEXT_PUBLIC_SITE_URL=https://notelm.onrender.com
# Leave empty so the UI calls /api on the same host (the site proxies to notelm-api):
# NEXT_PUBLIC_API_URL=
# Render site container → inference service:
# API_UPSTREAM=https://notelm-api.onrender.com
# Mainland China: Hugging Face Hub
# HF_ENDPOINT=https://hf-mirror.com
NOTIFY_EMAIL=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
RUNPOD_API_KEY=rpa_your-runpod-api-key
# Gated GigaMIDI (accept terms on the Hub first):
# HF_TOKEN=hf_...
